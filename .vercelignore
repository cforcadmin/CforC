# Τι ΔΕΝ ανεβαίνει ποτέ στο Vercel.
#
# Τα deploy μέσω git δεν τα έστελναν ποτέ αυτά (είναι στο .gitignore, άρα
# δεν υπάρχουν καν στο repo). Το `vercel --prod` από τον υπολογιστή όμως
# στέλνει ΤΟΝ ΦΑΚΕΛΟ, όχι το repo — και την 1/10/2026 ξεκίνησε να ανεβάζει
# 1,7 GB. Μέσα σε αυτά, ΟΛΟΚΛΗΡΟ το _Database_Backup: τα αντίγραφα του
# μητρώου μελών με τα ~1.977 αρχεία πολυμέσων.
#
# Κανένα από αυτά δεν χρειάζεται για το build: το Vercel εγκαθιστά μόνο του
# τις εξαρτήσεις και χτίζει μόνο του το .next.

# Αντίγραφα της βάσης — προσωπικά δεδομένα μελών. ΠΟΤΕ.
_Database_Backup

# Δύο ξεχωριστά checkout ζουν μέσα σε αυτόν τον φάκελο — 1,8 GB μαζί.
# Και τα δύο είναι στο .gitignore, άρα τα deploy μέσω git δεν τα έστελναν
# ποτέ· η εξαίρεση εδώ αφορά ΜΟΝΟ το ανέβασμα από τον υπολογιστή.
StrapiDBforCforC
cms

# Το ιστορικό δεν χρειάζεται για build (184 MB)
.git

# Παράγωγα του build
.next
node_modules
