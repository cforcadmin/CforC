# Πρότυπο μεταβλητών περιβάλλοντος — ΧΩΡΙΣ ΤΙΜΕΣ.
#
# Αντίγραψέ το σε `.env.local` (που ΔΕΝ μπαίνει ποτέ στο git) και συμπλήρωσε.
# Οι πραγματικές τιμές της παραγωγής ζουν ΜΟΝΟ στο Vercel → Settings →
# Environment Variables, και τα μυστικά στο Vaultwarden.
#
# ──────────────────────────────────────────────────────────────────────────
# ΤΟ ΠΙΟ ΣΗΜΑΝΤΙΚΟ ΓΙΑ ΟΠΟΙΟΝ ΑΝΑΠΤΥΣΣΕΙ ΤΟΠΙΚΑ
#
# Δεν υπάρχει ξεχωριστό Strapi ανάπτυξης: το STRAPI_URL δείχνει στη ΖΩΝΤΑΝΗ
# βάση, με αληθινά ονόματα, email, τηλέφωνα και φωτογραφίες μελών.
#
# Γι' αυτό το STRAPI_API_TOKEN σε ΤΟΠΙΚΟ μηχάνημα πρέπει να είναι διακριτικό
# ΜΟΝΟ ΑΝΑΓΝΩΣΗΣ (Strapi → Settings → API Tokens → Custom):
#
#   find/findOne ΜΟΝΟ           → member, membership-application,
#                                  receipt, oc-contract
#   γράψιμο επιτρεπτό           → oc-campaign, oc-run-log, oc-task
#
# Το διακριτικό πλήρους πρόσβασης μένει ΜΟΝΟ στο Vercel. Ένα αντίγραφο που
# μπορεί να ΑΛΛΑΞΕΙ το μητρώο μελών δεν έχει λόγο να κυκλοφορεί σε laptop —
# ούτε στο δικό σου, ούτε στου επόμενου συνεργάτη.
# ──────────────────────────────────────────────────────────────────────────

# ── Strapi
STRAPI_URL=
NEXT_PUBLIC_STRAPI_URL=
STRAPI_API_TOKEN=

# ── Ταυτότητα
JWT_SECRET=

# ── Email και newsletter
RESEND_API_KEY=
SENDER_API_KEY=
SENDER_GROUP_ID=
SENDER_PAID_GROUP_ID=
ACCOUNTANT_EMAIL=

# ── Google (ένας λογαριασμός υπηρεσίας για όλα)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=
GOOGLE_CALENDAR_ID=

# ── Google: προαιρετικά· ο κώδικας έχει εφεδρικές τιμές στα lib/
GOOGLE_AGENDA_DOC_ID=
CONTRACTS_SHEET_ID=
GOOGLE_LIBRARY_SHEET_ID=
GOOGLE_LIBRARY_FOLDER_ID=

# ── Φύλλα με Apps Script
FINANCE_SHEET_WEBAPP_URL=
FINANCE_SHEET_WEBAPP_SECRET=
SHEET_WEBAPP_URL=
SHEET_WEBAPP_SECRET=

# ── Λειτουργία
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=

# ── Προαιρετικά
GA4_PROPERTY_ID=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
